{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "bugsnag/bugsnag-laravel": "^2.22",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.3",
        "intervention/image": "^2.6",
        "laravel/framework": "^8.54",
        "laravel/sanctum": "^2.11",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.3",
        "spatie/laravel-permission": "^5.1",
        "spatie/laravel-translatable": "^4.6",
        "twilio/sdk": "^6.28"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "*",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Product\\": "app/Modules/Product",
            "Category\\": "app/Modules/Category",
            "Contact\\": "app/Modules/Contact",
            "Slider\\": "app/Modules/Slider",
            "Page\\": "app/Modules/Page",
            "Setting\\": "app/Modules/Setting",
            "Testimonial\\": "app/Modules/Testimonial",
            "User\\": "app/Modules/User",
            "Job\\": "app/Modules/Job",
            "News\\": "app/Modules/News",
            "Distributor\\": "app/Modules/Distributor",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Distributor\\Database\\Seeders\\": "app/Modules/Distributor/database/seeds/",
            "Job\\Database\\Seeders\\": "app/Modules/Job/database/seeds/",
            "Setting\\Database\\Seeders\\": "app/Modules/Setting/database/seeds/",
            "User\\Database\\Seeders\\": "app/Modules/User/database/seeds/",
            "Testimonial\\Database\\Seeders\\": "app/Modules/Testimonial/database/seeds/",
            "Product\\Database\\Seeders\\": "app/Modules/Product/database/seeds/",
            "Category\\Database\\Seeders\\": "app/Modules/Category/database/seeds/",
            "ContactUS\\Database\\Seeders\\": "app/Modules/Contact/database/seeds/",
            "Slider\\Database\\Seeders\\": "app/Modules/Slider/database/seeds/",
            "News\\Database\\Seeders\\": "app/Modules/News/database/seeds/",
            "Page\\Database\\Seeders\\": "app/Modules/Page/database/seeds/"
        },
        "files": [
            "app/Helpers/helper.php",
            "app/Helpers/settings.php",
            "app/Helpers/constants.php",
            "app/Helpers/module.php",
            "app/Helpers/transModule.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
